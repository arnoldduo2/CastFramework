<?php

declare(strict_types=1);

namespace {namespace};

use InvalidArgumentException;

/**
 * {class}: draws Code 128 barcodes (the one used for product codes, invoice numbers and shipping labels) as SVG, with no library.
 * An SVG prints sharp at any size and can go straight into a view or a PDF.
 *
 *   $svg = (new \{namespace}\{class}())->svg('INV-2026-0042');          // echo it in a view:  <?= $svg ?>
 *   $svg = (new \{namespace}\{class}())->svg('12345', height: 60, bar: 2, caption: false);
 *
 * Bind it once (AppServiceProvider::register):  $this->app->singleton('{key}', fn() => new \{namespace}\{class}());
 * For EAN-13 / UPC (retail packaging) or 2D codes use a library such as picqer/php-barcode-generator.
 */
final class {class}
{
    /** Bar/space widths of Code 128 symbols 0-105 (six numbers each), then the stop symbol. */
    private const PATTERNS = [
        '212222', '222122', '222221', '121223', '121322', '131222', '122213', '122312', '132212', '221213', '221312', '231212', '112232', '122132', '122231', '113222',
        '123122', '123221', '223211', '221132', '221231', '213212', '223112', '312131', '311222', '321122', '321221', '312212', '322112', '322211', '212123', '212321',
        '232121', '111323', '131123', '131321', '112313', '132113', '132311', '211313', '231113', '231311', '112133', '112331', '132131', '113123', '113321', '133121',
        '313121', '211331', '231131', '213113', '213311', '213131', '311123', '311321', '331121', '312113', '312311', '332111', '314111', '221411', '431111', '111224',
        '111422', '121124', '121421', '141122', '141221', '112214', '112412', '122114', '122411', '142112', '142211', '241211', '221114', '413111', '241112', '134111',
        '111242', '121142', '121241', '114212', '124112', '124211', '411212', '421112', '421211', '212141', '214121', '412121', '111143', '111341', '131141', '114113',
        '114311', '411113', '411311', '113141', '114131', '311141', '411131', '211412', '211214', '211232',
    ];
    private const STOP = '2331112';
    private const START_B = 104;

    /** The widths (bar, space, bar ...) of the whole symbol for a text of printable ASCII characters. @return list<int> */
    public function widths(string $text): array
    {
        if ($text === '' || preg_match('/[^\x20-\x7e]/', $text)) {
            throw new InvalidArgumentException('A Code 128 barcode here holds printable ASCII characters only (letters, digits, punctuation, space).');
        }
        $values = [self::START_B];
        $sum = self::START_B;
        foreach (str_split($text) as $i => $char) {
            $value = ord($char) - 32;
            $values[] = $value;
            $sum += $value * ($i + 1);
        }
        $values[] = $sum % 103;                      // check symbol

        $widths = [];
        foreach ($values as $value) array_push($widths, ...array_map('intval', str_split(self::PATTERNS[$value])));
        array_push($widths, ...array_map('intval', str_split(self::STOP)));
        return $widths;
    }

    /**
     * @param int $bar      width of the thinnest bar in pixels
     * @param int $height   bar height in pixels
     * @param bool $caption print the text under the bars
     */
    public function svg(string $text, int $bar = 2, int $height = 70, bool $caption = true): string
    {
        $bars = '';
        $x = 10 * $bar;                              // quiet zone
        $black = true;
        foreach ($this->widths($text) as $w) {
            if ($black) $bars .= '<rect x="' . $x . '" y="0" width="' . ($w * $bar) . '" height="' . $height . '"/>';
            $x += $w * $bar;
            $black = !$black;
        }
        $width = $x + 10 * $bar;
        $label = $caption ? '<text x="' . ($width / 2) . '" y="' . ($height + 16) . '" text-anchor="middle" font-family="monospace" font-size="14">' . htmlspecialchars($text, ENT_QUOTES) . '</text>' : '';
        $total = $height + ($label !== '' ? 22 : 0);
        return '<svg xmlns="http://www.w3.org/2000/svg" width="' . $width . '" height="' . $total . '" viewBox="0 0 ' . $width . ' ' . $total . '" role="img" aria-label="Barcode ' . htmlspecialchars($text, ENT_QUOTES) . '">'
            . '<rect width="100%" height="100%" fill="#fff"/><g fill="#000">' . $bars . '</g>' . $label . '</svg>';
    }
}
