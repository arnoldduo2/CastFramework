:root { --bg: #f4f4f5; --card: #fff; --text: #18181b; --muted: #71717a; --accent: #16a34a; --line: #e4e4e7; }
@media (prefers-color-scheme: dark) {
  :root { --bg: #111214; --card: #1b1d21; --text: #ececec; --muted: #9aa0a6; --accent: #4ade80; --line: #2f3338; }
}
* { box-sizing: border-box; }
body { margin: 0; height: 100dvh; display: flex; flex-direction: column; background: var(--bg); color: var(--text); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
.topbar { padding: 12px 20px; background: var(--card); border-bottom: 1px solid var(--line); }
.brand { font-weight: 700; color: var(--accent); text-decoration: none; }
.page { flex: 1 1 auto; min-height: 0; overflow-y: auto; width: 100%; padding: 24px max(16px, calc((100% - 760px) / 2)) 48px; display: grid; gap: 16px; align-content: start; }
.foot { position: fixed; bottom: 0; left: 0; width: 100%; border-top: 1px solid var(--line); background: var(--card); text-align: center; color: var(--muted); font-size: 12px; padding: 5px; }
.card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 20px; }
a { color: var(--accent); }
code { background: var(--bg); padding: 1px 5px; border-radius: 4px; }
