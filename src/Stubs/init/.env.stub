APP_NAME="{{app_name}}"
APP_ENV=development
APP_DEBUG=true
# URL folder when the app is not at the web root, e.g. /my-app/public (leave empty otherwise)
APP_BASE_PATH=

# Comma separated origins allowed to call the app from another site (CORS). Empty = none.
CORS_ALLOWED_ORIGINS=

# Database: sqlite file, or mysql / pgsql with DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASS
DB_CONN=sqlite
DB_NAME=storage/database.sqlite
