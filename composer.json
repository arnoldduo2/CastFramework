{
    "name": "anode/cast-framework",
    "version": "2.2.1",
    "description": "CastFramework: a small PHP MVC framework with an SPA-ready view layer, built on CastTemplateEngine.",
    "type": "composer-plugin",
    "license": "MIT",
    "keywords": [
        "framework",
        "mvc",
        "spa",
        "php",
        "cast"
    ],
    "homepage": "https://github.com/arnoldduo2/CastFramework",
    "authors": [
        {
            "name": "arnoldduo2",
            "email": "arnoldduo2@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-openssl": "*",
        "ext-ctype": "*",
        "anode/cast-template-engine": "^1.5.0",
        "anode/error-handler": "^1.3.0",
        "composer-plugin-api": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Cast\\": "src/",
            "App\\": "src/"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "bin": [
        "bin/cast"
    ],
    "scripts": {
        "test": "phpunit",
        "test:plain": "php tests/run.php",
        "docs": "php bin/cast docs:build --source=docs --readme=README.md --out=src/Resources/docs",
        "docs:check": "php bin/cast docs:build --source=docs --readme=README.md --out=src/Resources/docs --check"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "extra": {
        "class": "Cast\\Composer\\Plugin"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../CastTemplateEngine",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "CastTemplateEngine\\": "../CastTemplateEngine/src/"
        },
        "files": [
            "../CastTemplateEngine/src/helpers.php"
        ]
    }
}