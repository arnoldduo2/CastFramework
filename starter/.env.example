# --- Application ---------------------------------------------------------
APP_NAME="Cast Starter"
# development | production
APP_ENV=development
# true shows error details. Never true in production.
APP_DEBUG=true
# Secret used by sign() and encrypt(). Made by: php cast key:generate
APP_KEY=
APP_TIMEZONE=UTC
# URL folder when the app is not at the web root, e.g. /my-app/public (leave empty otherwise)
APP_BASE_PATH=
# Shown by the updater; optional
# APP_VERSION=1.0.0
# View file extension (default .cast.php)
# APP_VIEWS_EXT=.cast.php

# --- Session cookie -------------------------------------------------------
SESSION_NAME=cast_session
# Seconds; 0 = until the browser closes
COOKIE_LIFE=0
COOKIE_PATH=/
COOKIE_DOMAIN=
# true when the site is served over https
COOKIE_SECURE=false
# true: scripts cannot read the cookie
COOKIE_HTTP_ONLY=true
# Lax | Strict | None (None needs COOKIE_SECURE=true)
COOKIE_SITE=Lax

# --- Other sites calling this app (CORS) ----------------------------------
# Comma separated exact origins, e.g. http://localhost:5173,https://app.example.com. Empty = none.
CORS_ALLOWED_ORIGINS=

# --- Database ---------------------------------------------------------------
# sqlite | mysql | pgsql. For sqlite DB_NAME is the file.
DB_CONN=sqlite
DB_NAME=storage/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=
# DB_PASS=
