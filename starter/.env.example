APP_NAME="Cast Starter"
APP_ENV=development
APP_DEBUG=true
# URL folder when the app is not at the web root, e.g. /cast-starter (leave empty otherwise)
APP_BASE_PATH=

# Comma separated origins allowed to call the app from another site (CORS). Empty = none.
CORS_ALLOWED_ORIGINS=

# SQLite file for the demo (created on first request)
DB_CONN=sqlite
DB_NAME=storage/database.sqlite
